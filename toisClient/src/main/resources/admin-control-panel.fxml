<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="ru.nsu.tois.client.controller.AdminControlPanelController"
            styleClass="admin-window">

    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="8"
              styleClass="admin-menu-bar">
            <padding>
                <Insets top="10" right="14" bottom="10" left="14"/>
            </padding>

            <Label text="Панель управления"
                   styleClass="panel-title-label"/>
        </HBox>
    </top>

    <center>
        <HBox spacing="14">
            <padding>
                <Insets top="14" right="14" bottom="14" left="14"/>
            </padding>

            <VBox spacing="10"
                  HBox.hgrow="ALWAYS"
                  styleClass="control-panel-section">
                <Label text="Роли"
                       styleClass="section-title-label"/>

                <ListView fx:id="rolesListView"
                          VBox.vgrow="ALWAYS"
                          styleClass="admin-list-view"/>

                <HBox spacing="8"
                      alignment="CENTER_RIGHT">
                    <Button text="Добавить роль"
                            onAction="#onAddRole"
                            mnemonicParsing="false"
                            styleClass="primary-button"/>
                    <Button text="Редактировать"
                            onAction="#onEditRole"
                            mnemonicParsing="false"
                            styleClass="secondary-button"/>
                    <Button text="Удалить"
                            onAction="#onDeleteRole"
                            mnemonicParsing="false"
                            styleClass="danger-button"/>
                </HBox>
            </VBox>

            <VBox spacing="10"
                  HBox.hgrow="ALWAYS"
                  styleClass="control-panel-section">
                <Label text="Permissions"
                       styleClass="section-title-label"/>

                <ListView fx:id="permissionsListView"
                          VBox.vgrow="ALWAYS"
                          styleClass="admin-list-view"/>

                <HBox spacing="8"
                      alignment="CENTER_RIGHT">
                    <Button text="Добавить"
                            onAction="#onAddUserAccount"
                            mnemonicParsing="false"
                            styleClass="primary-button"/>
                    <Button text="Редактировать"
                            onAction="#onEditUserAccount"
                            mnemonicParsing="false"
                            styleClass="secondary-button"/>
                    <Button text="Удалить"
                            onAction="#onDeleteUserAccount"
                            mnemonicParsing="false"
                            styleClass="danger-button"/>
                </HBox>
            </VBox>

            <VBox spacing="10"
                  HBox.hgrow="ALWAYS"
                  styleClass="control-panel-section">
                <Label text="Учетные записи"
                       styleClass="section-title-label"/>

                <ListView fx:id="userAccountsListView"
                          VBox.vgrow="ALWAYS"
                          styleClass="admin-list-view"/>

                <HBox spacing="8"
                      alignment="CENTER_RIGHT">
                    <Button text="Добавить"
                            onAction="#onAddUserAccount"
                            mnemonicParsing="false"
                            styleClass="primary-button"/>
                    <Button text="Редактировать"
                            onAction="#onEditUserAccount"
                            mnemonicParsing="false"
                            styleClass="secondary-button"/>
                    <Button text="Удалить"
                            onAction="#onDeleteUserAccount"
                            mnemonicParsing="false"
                            styleClass="danger-button"/>
                    <Button text="Логин/пароль"
                            onAction="#onEditUserAccountCredentials"
                            mnemonicParsing="false"
                            styleClass="secondary-button"/>
                    <Button text="Вкл/выкл"
                            onAction="#onToggleUserAccountActive"
                            mnemonicParsing="false"
                            styleClass="secondary-button"/>
                </HBox>
            </VBox>
        </HBox>
    </center>
</BorderPane>
