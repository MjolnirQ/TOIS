<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.controller.SellerController"
            styleClass="seller-window">

    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="10"
              styleClass="seller-top-bar">
            <padding>
                <Insets top="10" right="14" bottom="10" left="14"/>
            </padding>

            <Label text="Торговая точка"
                   styleClass="field-label"/>

            <ComboBox fx:id="tradePointComboBox"
                      prefWidth="420"
                      maxWidth="520"
                      styleClass="role-combo"/>

            <Button text="Обновить остатки"
                    mnemonicParsing="false"
                    onAction="#onRefreshCatalog"
                    styleClass="secondary-button"/>

            <Label fx:id="sellerStatusLabel"
                   text="Назначения не загружены"
                   styleClass="muted-label"/>
        </HBox>
    </top>

    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE"
                 styleClass="seller-tab-pane">
            <tabs>
                <Tab text="Остатки и цены">
                    <content>
                        <BorderPane>
                            <center>
                                <TableView fx:id="catalogTable"
                                           styleClass="query-result-table">
                                    <BorderPane.margin>
                                        <Insets top="14" right="14" bottom="14" left="14"/>
                                    </BorderPane.margin>
                                </TableView>
                            </center>
                        </BorderPane>
                    </content>
                </Tab>

                <Tab text="Продажа">
                    <content>
                        <VBox spacing="10"
                              styleClass="seller-workspace">
                            <padding>
                                <Insets top="14" right="14" bottom="14" left="14"/>
                            </padding>

                            <HBox alignment="CENTER_LEFT"
                                  spacing="8">
                                <Label text="Дата"
                                       styleClass="field-label"/>
                                <DatePicker fx:id="saleDatePicker"/>

                                <Label text="Покупатель"
                                       styleClass="field-label"/>
                                <TextField fx:id="customerFullNameField"
                                           promptText="ФИО"
                                           prefWidth="220"
                                           styleClass="text-input-field"/>
                                <TextField fx:id="customerPhoneField"
                                           promptText="Телефон"
                                           prefWidth="150"
                                           styleClass="text-input-field"/>
                                <Button text="Создать покупателя"
                                        mnemonicParsing="false"
                                        onAction="#onCreateCustomer"
                                        styleClass="secondary-button"/>
                                <Button text="Очистить"
                                        mnemonicParsing="false"
                                        onAction="#onClearCustomer"
                                        styleClass="secondary-button"/>
                                <Label fx:id="customerStateLabel"
                                       text="Покупатель не выбран"
                                       styleClass="muted-label"/>
                            </HBox>

                            <HBox alignment="CENTER_LEFT"
                                  spacing="8">
                                <Label text="Количество"
                                       styleClass="field-label"/>
                                <Spinner fx:id="saleQuantitySpinner"
                                         editable="true"
                                         prefWidth="110"/>
                                <Button text="Добавить выбранный товар"
                                        mnemonicParsing="false"
                                        onAction="#onAddSelectedProductToSale"
                                        styleClass="primary-button"/>
                                <Button text="Удалить позицию"
                                        mnemonicParsing="false"
                                        onAction="#onRemoveSaleItem"
                                        styleClass="secondary-button"/>
                                <Button text="Очистить позиции"
                                        mnemonicParsing="false"
                                        onAction="#onClearSaleItems"
                                        styleClass="secondary-button"/>
                            </HBox>

                            <TableView fx:id="saleItemsTable"
                                       VBox.vgrow="ALWAYS"
                                       styleClass="query-result-table"/>

                            <HBox alignment="CENTER_RIGHT"
                                  spacing="8">
                                <Label fx:id="saleResultLabel"
                                       text=""
                                       styleClass="muted-label"/>
                                <Button text="Показать мои продажи"
                                        mnemonicParsing="false"
                                        onAction="#onLoadSalesHistory"
                                        styleClass="secondary-button"/>
                                <Button text="Создать продажу"
                                        mnemonicParsing="false"
                                        onAction="#onCreateSale"
                                        styleClass="primary-button"/>
                            </HBox>

                            <TableView fx:id="salesHistoryTable"
                                       prefHeight="150"
                                       styleClass="query-result-table"/>
                        </VBox>
                    </content>
                </Tab>

                <Tab text="Заявка на поставку">
                    <content>
                        <VBox spacing="10"
                              styleClass="seller-workspace">
                            <padding>
                                <Insets top="14" right="14" bottom="14" left="14"/>
                            </padding>

                            <HBox alignment="CENTER_LEFT"
                                  spacing="8">
                                <Label text="Дата"
                                       styleClass="field-label"/>
                                <DatePicker fx:id="supplyRequestDatePicker"/>
                                <Label text="Статус"
                                       styleClass="field-label"/>
                                <ComboBox fx:id="supplyStatusComboBox"
                                          prefWidth="130"/>
                                <Label text="Количество"
                                       styleClass="field-label"/>
                                <Spinner fx:id="supplyQuantitySpinner"
                                         editable="true"
                                         prefWidth="120"/>
                                <Button text="Добавить выбранный товар"
                                        mnemonicParsing="false"
                                        onAction="#onAddSelectedProductToSupply"
                                        styleClass="secondary-button"/>
                            </HBox>

                            <HBox alignment="CENTER_LEFT"
                                  spacing="8">
                                <Label text="Новый товар"
                                       styleClass="field-label"/>
                                <TextField fx:id="supplyProductNameField"
                                           promptText="Название"
                                           prefWidth="260"
                                           styleClass="text-input-field"/>
                                <ComboBox fx:id="supplyUnitsComboBox"
                                          prefWidth="150"/>
                                <Button text="Добавить новый товар"
                                        mnemonicParsing="false"
                                        onAction="#onAddNewProductToSupply"
                                        styleClass="secondary-button"/>
                                <Button text="Удалить позицию"
                                        mnemonicParsing="false"
                                        onAction="#onRemoveSupplyItem"
                                        styleClass="secondary-button"/>
                                <Button text="Очистить позиции"
                                        mnemonicParsing="false"
                                        onAction="#onClearSupplyItems"
                                        styleClass="secondary-button"/>
                            </HBox>

                            <TableView fx:id="supplyItemsTable"
                                       VBox.vgrow="ALWAYS"
                                       styleClass="query-result-table"/>

                            <HBox alignment="CENTER_RIGHT"
                                  spacing="8">
                                <Label fx:id="supplyResultLabel"
                                       text=""
                                       styleClass="muted-label"/>
                                <Button text="Создать заявку"
                                        mnemonicParsing="false"
                                        onAction="#onCreateSupplyRequest"
                                        styleClass="primary-button"/>
                            </HBox>
                        </VBox>
                    </content>
                </Tab>

                <Tab text="Выработка">
                    <content>
                        <VBox spacing="10"
                              styleClass="seller-workspace">
                            <padding>
                                <Insets top="14" right="14" bottom="14" left="14"/>
                            </padding>

                            <HBox alignment="CENTER_LEFT"
                                  spacing="8">
                                <Label text="С"
                                       styleClass="field-label"/>
                                <DatePicker fx:id="outputFromDatePicker"/>
                                <Label text="по"
                                       styleClass="field-label"/>
                                <DatePicker fx:id="outputToDatePicker"/>
                                <Button text="Показать выработку"
                                        mnemonicParsing="false"
                                        onAction="#onLoadOutput"
                                        styleClass="primary-button"/>
                            </HBox>

                            <TableView fx:id="outputTable"
                                       VBox.vgrow="ALWAYS"
                                       styleClass="query-result-table"/>
                        </VBox>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </center>
</BorderPane>
