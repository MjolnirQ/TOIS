<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.controller.TradeManagerController"
            styleClass="manager-window">

    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="10"
              styleClass="manager-top-bar">
            <padding>
                <Insets top="10" right="14" bottom="10" left="14"/>
            </padding>

            <Label text="Менеджер торговли"
                   styleClass="panel-title-label"/>

            <Label text="Раздел"
                   styleClass="field-label"/>

            <ComboBox fx:id="groupComboBox"
                      prefWidth="260"
                      styleClass="role-combo"/>

            <Button text="Обновить справочники"
                    mnemonicParsing="false"
                    onAction="#onRefreshLookups"
                    styleClass="secondary-button"/>
        </HBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.28"
                   styleClass="manager-split-pane">
            <items>
                <VBox spacing="8"
                      styleClass="manager-sidebar">
                    <padding>
                        <Insets top="12" right="10" bottom="12" left="12"/>
                    </padding>

                    <Label text="Операции"
                           styleClass="section-title-label"/>

                    <ListView fx:id="actionListView"
                              VBox.vgrow="ALWAYS"
                              styleClass="manager-action-list"/>
                </VBox>

                <BorderPane styleClass="manager-workspace">
                    <top>
                        <VBox spacing="10">
                            <padding>
                                <Insets top="12" right="14" bottom="10" left="14"/>
                            </padding>

                            <HBox alignment="CENTER_LEFT"
                                  spacing="10">
                                <Label fx:id="actionTitleLabel"
                                       text="Операция не выбрана"
                                       styleClass="section-title-label"/>

                                <Button text="Выполнить"
                                        mnemonicParsing="false"
                                        onAction="#onExecuteAction"
                                        styleClass="primary-button"/>

                                <Label fx:id="statusLabel"
                                       text=""
                                       styleClass="muted-label"/>
                            </HBox>

                            <ScrollPane fitToWidth="true"
                                        prefViewportHeight="190"
                                        styleClass="manager-form-scroll">
                                <content>
                                    <GridPane fx:id="formGrid"
                                              hgap="10"
                                              vgap="6"
                                              styleClass="manager-form-grid"/>
                                </content>
                            </ScrollPane>

                            <VBox fx:id="itemEditorBox"
                                  spacing="8"
                                  styleClass="manager-item-editor">
                                <Label fx:id="itemEditorLabel"
                                       text="Позиции"
                                       styleClass="section-title-label"/>

                                <GridPane fx:id="itemFormGrid"
                                          hgap="10"
                                          vgap="6"
                                          styleClass="manager-form-grid"/>

                                <HBox spacing="8"
                                      alignment="CENTER_RIGHT">
                                    <Button fx:id="addItemButton"
                                            text="Добавить позицию"
                                            mnemonicParsing="false"
                                            onAction="#onAddItem"
                                            styleClass="secondary-button"/>

                                    <Button fx:id="removeItemButton"
                                            text="Удалить позицию"
                                            mnemonicParsing="false"
                                            onAction="#onRemoveItem"
                                            styleClass="secondary-button"/>

                                    <Button fx:id="clearItemsButton"
                                            text="Очистить позиции"
                                            mnemonicParsing="false"
                                            onAction="#onClearItems"
                                            styleClass="secondary-button"/>
                                </HBox>

                                <TableView fx:id="itemTable"
                                           prefHeight="120"
                                           styleClass="query-result-table"/>
                            </VBox>
                        </VBox>
                    </top>

                    <center>
                        <TableView fx:id="resultTable"
                                   styleClass="query-result-table">
                            <BorderPane.margin>
                                <Insets top="4" right="14" bottom="14" left="14"/>
                            </BorderPane.margin>
                        </TableView>
                    </center>
                </BorderPane>
            </items>
        </SplitPane>
    </center>
</BorderPane>
